# AWS credentials for photo-terminal
#
# Copy this file to .env and fill in your actual AWS credentials:
#   cp .env.example .env
#
# .env is gitignored and will never be committed to the repository.
#
# direnv automatically loads this file when you enter the project directory
# (see .envrc: `dotenv_if_exists .env`), so these variables are available to
# the app with no AWS CLI profile setup required.
#
# aws_profile in photo-uploader.yaml is optional. If AWS_ACCESS_KEY_ID is set
# here, boto3 uses it and takes precedence over any configured profile.

AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# Optional: only needed when using temporary/STS credentials
# AWS_SESSION_TOKEN=your-session-token-here
